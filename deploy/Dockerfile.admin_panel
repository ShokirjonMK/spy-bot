FROM golang:1.24.4-alpine3.21 AS builder

WORKDIR /app
ENV GOWORK=off

COPY admin_panel/ ./

RUN go mod tidy
RUN CGO_ENABLED=0 go build -ldflags='-s -w -extldflags "-static"' -o /bin/admin_panel .


FROM alpine:3.21

RUN apk add --no-cache ca-certificates
RUN addgroup -g 101 appgroup && adduser -D -u 101 -G appgroup appuser
USER appuser

COPY --from=builder /bin/admin_panel /admin_panel

EXPOSE 8090
CMD ["/admin_panel"]
